**/__pycache__/
*.py[cod]
*.pyo
*.pyd

*.sqlite3
db.sqlite3
*.db

.env
.env.*
venv/
.venv/
ENV/
env/

*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Next.js / Node
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

.vercel/
.pnp
.pnp.js
.yarn/install-state.gz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Media / generated artifacts
media/generated_videos/
media/generated_content/

# Vector store / runtime storage
storage/
learning/storage/

# Secrets / credentials
*.pem
learning/google-authetication.json
learning/google-authentication.json